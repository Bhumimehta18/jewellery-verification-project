<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Jewellery Certification</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/_Layout.cshtml.css" />
    <link rel="stylesheet" href="~/css/premium-ui.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" href="/">Jewellery Certification</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto">
                    @if (Context.Session.GetString("Username") != null)
                    {
                        <!-- ✅ When logged in -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="DataEntry" asp-action="Index">Data Entry</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Analytics" asp-action="Index">Analytics</a>
                        </li>
                        <!-- ✅ Newly added link -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="JewelleryRecords" asp-action="Index">Jewellery Records</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">
                                Logout (@Context.Session.GetString("Username"))
                            </a>
                        </li>
                    }
                    else
                    {
                        <!-- ✅ When logged out -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="DataEntry" asp-action="Index">Data Entry</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Analytics" asp-action="Index">Analytics</a>
                        </li>
                        <!-- ✅ Show Jewellery Records for guests too (optional) -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="JewelleryRecords" asp-action="Index">Jewellery Records</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Welcome">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-5">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
