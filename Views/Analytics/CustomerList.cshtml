@model IEnumerable<string>

@{
    ViewData["Title"] = "All Customers";
    string search = ViewBag.Search as string;
}

<div class="container mt-4">
    <h2 class="text-center mb-4 text-primary">👥 All Customers</h2>

    <!-- ✅ Search Bar -->
    <form method="get" action="@Url.Action("Customers", "Analytics")" class="d-flex mb-4 justify-content-center">
        <input type="text" name="search" value="@search" class="form-control w-50 shadow-sm" placeholder="Search customer name..." />
        <button type="submit" class="btn btn-primary ms-2 px-4">
            <i class="bi bi-search"></i> Search
        </button>
    </form>

    <div class="card shadow-sm p-3">
        <ul class="list-group list-group-flush">
            @foreach (var customer in Model)
            {
                <li class="list-group-item">@customer</li>
            }
        </ul>
    </div>

    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "Analytics")" class="btn btn-outline-secondary">
            ← Back to Dashboard
        </a>
    </div>
</div>
