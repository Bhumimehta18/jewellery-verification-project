@{
    ViewData["Title"] = "Analytics Dashboard";
    var certificateTypeCounts = ViewBag.CertificateTypeCounts as IEnumerable<dynamic>;
    var yearlyCounts = ViewBag.YearlyCounts as IEnumerable<dynamic>;
    int totalCustomers = ViewBag.TotalCustomers;
}

<div class="container mt-4">
    <h2 class="text-center mb-4">📊 Analytics Dashboard</h2>

    <!-- Summary Cards -->
    <div class="row text-center mb-4">
        <!-- ✅ Clickable Total Customers Card -->
        <div class="col-md-6">
            <a href="@Url.Action("Customers", "Analytics")" style="text-decoration:none; color:inherit;">
                <div class="card shadow-sm p-3 border-0" 
                     style="cursor:pointer; background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 1rem;">
                    <h4>Total Customers</h4>
                    <h2 class="text-primary fw-bold">@totalCustomers</h2>
                </div>
            </a>
        </div>

        <!-- Total Certificates -->
        <div class="col-md-6">
            <div class="card shadow-sm p-3 border-0" 
                 style="background: linear-gradient(135deg, #dcfce7, #bbf7d0); border-radius: 1rem;">
                <h4>Total Certificates</h4>
                <h2 class="text-success fw-bold">@certificateTypeCounts?.Sum(c => (int)c.Count)</h2>
            </div>
        </div>
    </div>

    <!-- Certificates by Type -->
    <div class="card shadow-sm mb-5">
        <div class="card-body">
            <h4 class="mb-3 text-primary">Certificates by Type</h4>
            <canvas id="certificateTypeChart" height="120"></canvas>
        </div>
    </div>

    <!-- Yearly Certificates -->
    <div class="card shadow-sm mb-5">
        <div class="card-body">
            <h4 class="mb-3 text-success">Yearly Certificates</h4>
            <canvas id="yearlyChart" height="120"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

    <script>
        const certLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            certificateTypeCounts?.Select(c => (string)c.Type) ?? new List<string>())
        );
        const certValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            certificateTypeCounts?.Select(c => (int)c.Count) ?? new List<int>())
        );

        new Chart(document.getElementById("certificateTypeChart"), {
            type: 'bar',
            data: {
                labels: certLabels,
                datasets: [{
                    label: 'Total Certificates',
                    data: certValues,
                    backgroundColor: 'rgba(54,162,235,0.7)',
                    borderColor: 'rgba(54,162,235,1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    datalabels: {
                        color: '#000',
                        anchor: 'end',
                        align: 'top',
                        font: { weight: 'bold', size: 14 },
                        formatter: value => value
                    }
                },
                scales: { y: { beginAtZero: true } }
            },
            plugins: [ChartDataLabels]
        });

        const yearLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            yearlyCounts?.Select(y => y.Year.ToString()) ?? new List<string>())
        );
        const yearValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            yearlyCounts?.Select(y => (int)y.Count) ?? new List<int>())
        );

        new Chart(document.getElementById("yearlyChart"), {
            type: 'bar',
            data: {
                labels: yearLabels,
                datasets: [{
                    label: 'Certificates per Year',
                    data: yearValues,
                    backgroundColor: 'rgba(75,192,192,0.7)',
                    borderColor: 'rgba(75,192,192,1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    datalabels: {
                        color: '#000',
                        anchor: 'end',
                        align: 'top',
                        font: { weight: 'bold', size: 14 },
                        formatter: value => value
                    }
                },
                scales: { y: { beginAtZero: true } }
            },
            plugins: [ChartDataLabels]
        });
    </script>
}
