@model IEnumerable<JewelleryVerificationProject.Models.Jewellery>
@{
    ViewData["Title"] = "Jewellery Records";
    var branches = new[] { "UNI DESIGN ELITE", "UD1 - UNI DESIGN UNIT 1", "UD2 - UNI DESIGN UNIT 2", "UD3 - UNI DESIGN UNIT 3", "UDI - UNI DESIGN INDIA", "UND - NOUVEAU" };
    var certTypes = new[] { "BIS", "DBCoO", "DGLA", "DHC", "IDT", "GSI", "IGI", "PGI", "SGL" };
}

<div class="container mt-4">

    <!-- ✅ Success / Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="successAlert" class="alert alert-success text-center fw-semibold shadow-sm mb-4">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="errorAlert" class="alert alert-danger text-center fw-semibold shadow-sm mb-4">
            @TempData["ErrorMessage"]
        </div>
    }

    <h2 class="mb-4 text-center fw-bold text-primary">Jewellery Records</h2>

    <!-- ✅ Filter Form -->
    <form method="get" asp-action="Index" class="card p-3 mb-4 shadow-sm border-0">
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-semibold">From Date</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">To Date</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Branch</label>
                <select name="branch" class="form-select">
                    <option value="">All</option>
                    @foreach (var b in branches)
                    {
                        <option value="@b" selected="@(ViewBag.Branch == b ? "selected" : null)">@b</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Certificate Type</label>
                <select name="certType" class="form-select">
                    <option value="">All</option>
                    @foreach (var c in certTypes)
                    {
                        <option value="@c" selected="@(ViewBag.CertType == c ? "selected" : null)">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Pieces (BagQN)</label>
                <input type="number" name="pieces" value="@ViewBag.Pieces" class="form-control" placeholder="e.g. 5" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Records</label>
                <select name="recordCount" class="form-select">
                    <option value="">All</option>
                    @foreach (var num in new[] { 10, 20, 30, 50, 100 })
                    {
                        <option value="@num" selected="@(ViewBag.RecordCount == num ? "selected" : null)">@num</option>
                    }
                </select>
            </div>
        </div>

        <!-- ✅ Buttons beside each other -->
        <div class="mt-3 text-end">
            <button type="submit" class="btn btn-primary px-4 me-2">
                <i class="bi bi-funnel"></i> Apply Filters
            </button>

            <!-- ✅ Export to Excel -->
            <button type="submit"
                    formaction="@Url.Action("ExportToExcel", "JewelleryRecords")"
                    formmethod="get"
                    class="btn btn-success px-4 shadow-sm">
                <i class="bi bi-file-earmark-excel"></i> Export to Excel
            </button>
        </div>
    </form>

    <!-- ✅ Data Table -->
    <div class="table-responsive">
        <table class="table table-bordered table-hover shadow-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Company Code</th>
                    <th>Bag No</th>
                    <th>Order No</th>
                    <th>Design No</th>
                    <th>BagQN</th>
                    <th>Customer</th>
                    <th>Certificate Type</th>
                    <th>Certificate Number</th>
                    <th>Certificate Enter Date</th>
                    <th>Gross Weight</th>
                    <th>Doc Number</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="12" class="text-center text-muted py-3">No records found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.CompanyCode</td>
                            <td>@item.BagNo</td>
                            <td>@item.OrderNo</td>
                            <td>@item.DesignNo</td>
                            <td>@item.BagQN</td>
                            <td>@item.Customer</td>
                            <td>@item.CertificateType</td>
                            <td>@item.CertificateNumber</td>
                            <td>@item.CertificateEnterDate.ToShortDateString()</td>
                            <td>@item.GrossWeight</td>
                            <td>@item.DocNumber</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- ✅ Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", new { fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, branch = ViewBag.Branch, certType = ViewBag.CertType, pieces = ViewBag.Pieces, recordCount = ViewBag.RecordCount, page = i })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        // ✅ Auto-hide success/error alert after 5 seconds
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(a => {
                a.classList.add('fade');
                setTimeout(() => a.remove(), 500);
            });
        }, 5000);
    </script>
}
